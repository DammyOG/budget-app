# Plaid credentials — sign up free at https://dashboard.plaid.com/signup
# Sandbox works out of the box with fake test institutions/logins.
# Switch PLAID_ENV to "production" (and use production keys) to link real
# accounts at Bank of America, Chase, Capital One, Ally, Robinhood, etc.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments
PLAID_COUNTRY_CODES=US

# Required for OAuth banks (Bank of America, Capital One, and most major US
# banks redirect to their own login page, then back here). Must exactly match
# a URL added to "Allowed redirect URIs" in the Plaid dashboard
# (Team Settings -> API -> Allowed redirect URIs). For local dev:
PLAID_REDIRECT_URI=http://localhost:5173/oauth-return

# Random 32-byte hex string used to encrypt Plaid access tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

DATABASE_URL="file:./dev.db"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
