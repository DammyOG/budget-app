generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One Plaid "Item" = one login at one institution (e.g. your BofA login
// covers both checking + credit; Chase, Cap One, Ally, Robinhood are
// each separate items since they're separate logins).
model PlaidItem {
  id              String   @id @default(cuid())
  itemId          String   @unique
  accessTokenEnc  String
  institutionId   String?
  institutionName String?
  transactionsCursor String?

  // Without these, a sync failure (most commonly an expired bank login) is
  // invisible: the dashboard keeps confidently showing balances from weeks
  // ago with nothing to say they're stale.
  lastSyncedAt    DateTime?
  needsReauth     Boolean  @default(false)
  lastSyncError   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accounts        Account[]
}

model Account {
  id               String   @id @default(cuid())
  plaidItemId      String?
  plaidAccountId   String?  @unique
  name             String
  officialName     String?
  institutionName  String
  type             String   // depository | credit | investment | loan | manual
  subtype          String?  // checking | savings | credit card | ira | brokerage ...
  mask             String?
  // Integer cents. Floats can't represent 0.1, so balances drifted and exact
  // comparisons needed tolerances; the name carries the unit because Int
  // alone can't tell dollars from cents.
  currentBalanceCents   Int?
  availableBalanceCents Int?
  isoCurrencyCode  String?  @default("USD")
  isManual         Boolean  @default(false)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // SetNull, not Cascade: removing an account archives it (see archivedAt)
  // rather than deleting it, and revoking the underlying Plaid connection
  // must not take the archived account's transaction history down with it.
  plaidItem    PlaidItem?    @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]
}

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  icon     String?
  isIncome Boolean  @default(false)
  // Money moving between the user's own accounts, which is neither income nor
  // spending. Previously this was a hardcoded set of category names checked in
  // four separate places, so marking your own category (say "Brokerage
  // deposit") as a transfer was impossible without editing the source.
  isTransfer Boolean  @default(false)
  createdAt  DateTime @default(now())

  transactions        Transaction[]
  budgets             Budget[]
  categorizationRules CategorizationRule[]
}

model Transaction {
  id                  String   @id @default(cuid())
  plaidTransactionId  String?  @unique
  accountId           String
  categoryId          String?
  // Integer cents, negative for money out. See src/money.ts.
  amountCents         Int
  // Magnitude of amount, stored because Prisma can't ORDER BY an expression
  // and sorting "biggest first" has to mean biggest either direction — a
  // $3,000 paycheck and a $3,000 rent payment are both big.
  absAmountCents      Int      @default(0)
  date                DateTime
  name                String
  merchantName        String?
  pending              Boolean @default(false)
  isManual            Boolean  @default(false)
  notes               String?
  // Which transfer this is a leg of, if any. Read through the two relations
  // below rather than stored here: see the Transfer model.

  // What kind of money movement this is, independent of its category.
  // Transfers are neither earning nor spending, so a single field beats
  // repeating "is it the Transfer category OR does it have a pair id?" at
  // every call site that touches money — miss one and transfers leak back in.
  kind       String  @default("expense") // expense | income | transfer
  kindLocked Boolean @default(false)     // user set it; re-sync must not clobber

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  // A transaction can be the sending side of at most one transfer and the
  // receiving side of at most one, enforced by the unique columns on Transfer.
  transferAsOutgoing Transfer? @relation("TransferOutgoing")
  transferAsIncoming Transfer? @relation("TransferIncoming")

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([kind])
  @@index([absAmountCents])
  // Duplicate detection groups on exactly these four.
  @@index([accountId, name, amountCents, date])
}

// One movement of money between two of the user's own accounts, owning both
// of its legs.
//
// This was previously a transferPairId on each transaction pointing at the
// other, which let a half-linked state exist: leg A pointing at B while B
// pointed at nothing, or at a third transaction. That state is excluded from
// income and spending but has nothing to collapse against, and the code grew
// guards for it — a "broken" flag in the pairs listing, a check that a leg
// wasn't already matched elsewhere. Here the pair is one row, so there is no
// way to write down half of one.
//
// Both sides are required and unique: a transaction can be the sending side
// of at most one transfer and the receiving side of at most one. Deleting
// either transaction cascades the transfer away, which dissolves the pair
// rather than leaving a leg pointing at something that no longer exists.
model Transfer {
  id         String   @id @default(cuid())
  outgoingId String   @unique
  incomingId String   @unique
  createdAt  DateTime @default(now())

  outgoing Transaction @relation("TransferOutgoing", fields: [outgoingId], references: [id], onDelete: Cascade)
  incoming Transaction @relation("TransferIncoming", fields: [incomingId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  month      String   // "YYYY-MM"
  amountCents Int // integer cents
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
}

model CategorizationRule {
  id      String @id @default(cuid())
  pattern String @unique // The raw descriptor the rule was taught from, kept for display
  // What the rule actually matches on. Keying off the raw descriptor meant a
  // rule could only ever match the one transaction it was learned from, since
  // every charge carries its own order id — teaching the app about one Amazon
  // charge taught it nothing about the next.
  merchantKey String  @unique
  categoryId  String
  confidence  Int      @default(100) // 0-100, raised when confirmed, lowered when rejected
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([pattern])
  @@index([merchantKey])
}
