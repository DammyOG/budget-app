generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One Plaid "Item" = one login at one institution (e.g. your BofA login
// covers both checking + credit; Chase, Cap One, Ally, Robinhood are
// each separate items since they're separate logins).
model PlaidItem {
  id              String   @id @default(cuid())
  itemId          String   @unique
  accessTokenEnc  String
  institutionId   String?
  institutionName String?
  transactionsCursor String?

  // Without these, a sync failure (most commonly an expired bank login) is
  // invisible: the dashboard keeps confidently showing balances from weeks
  // ago with nothing to say they're stale.
  lastSyncedAt    DateTime?
  needsReauth     Boolean  @default(false)
  lastSyncError   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  accounts        Account[]
}

model Account {
  id               String   @id @default(cuid())
  plaidItemId      String?
  plaidAccountId   String?  @unique
  name             String
  officialName     String?
  institutionName  String
  type             String   // depository | credit | investment | loan | manual
  subtype          String?  // checking | savings | credit card | ira | brokerage ...
  mask             String?
  currentBalance   Float?
  availableBalance Float?
  isoCurrencyCode  String?  @default("USD")
  isManual         Boolean  @default(false)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // SetNull, not Cascade: removing an account archives it (see archivedAt)
  // rather than deleting it, and revoking the underlying Plaid connection
  // must not take the archived account's transaction history down with it.
  plaidItem    PlaidItem?    @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]
}

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  icon     String?
  isIncome Boolean  @default(false)
  // Money moving between the user's own accounts, which is neither income nor
  // spending. Previously this was a hardcoded set of category names checked in
  // four separate places, so marking your own category (say "Brokerage
  // deposit") as a transfer was impossible without editing the source.
  isTransfer Boolean  @default(false)
  createdAt  DateTime @default(now())

  transactions        Transaction[]
  budgets             Budget[]
  categorizationRules CategorizationRule[]
}

model Transaction {
  id                  String   @id @default(cuid())
  plaidTransactionId  String?  @unique
  accountId           String
  categoryId          String?
  amount              Float    // positive = money out, negative = money in (Plaid convention)
  // Magnitude of amount, stored because Prisma can't ORDER BY an expression
  // and sorting "biggest first" has to mean biggest either direction — a
  // $3,000 paycheck and a $3,000 rent payment are both big.
  absAmount           Float    @default(0)
  date                DateTime
  name                String
  merchantName        String?
  pending              Boolean @default(false)
  isManual            Boolean  @default(false)
  notes               String?
  transferPairId      String?  // Links to another transaction if this is part of an inter-account transfer

  // What kind of money movement this is, independent of its category.
  // Transfers are neither earning nor spending, so a single field beats
  // repeating "is it the Transfer category OR does it have a pair id?" at
  // every call site that touches money — miss one and transfers leak back in.
  kind       String  @default("expense") // expense | income | transfer
  kindLocked Boolean @default(false)     // user set it; re-sync must not clobber

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([transferPairId])
  @@index([kind])
  @@index([absAmount])
  // Duplicate detection groups on exactly these four.
  @@index([accountId, name, amount, date])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  month      String   // "YYYY-MM"
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
}

model CategorizationRule {
  id      String @id @default(cuid())
  pattern String @unique // The raw descriptor the rule was taught from, kept for display
  // What the rule actually matches on. Keying off the raw descriptor meant a
  // rule could only ever match the one transaction it was learned from, since
  // every charge carries its own order id — teaching the app about one Amazon
  // charge taught it nothing about the next.
  merchantKey String  @unique
  categoryId  String
  confidence  Int      @default(100) // 0-100, raised when confirmed, lowered when rejected
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([pattern])
  @@index([merchantKey])
}
